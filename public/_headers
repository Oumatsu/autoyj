# Cache content-hashed Next/Vinext static assets immutably
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Long-term edge and browser cache for media, images, and brand assets
/pic/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/insights/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

