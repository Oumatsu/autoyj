{
  "name": "youguard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:local:init && vinext dev",
    "build": "vinext build",
    "build:cloudflare": "BUILD_TARGET=cloudflare vinext build",
    "build:standalone": "BUILD_TARGET=standalone vinext build",
    "build:server": "vinext build",
    "start": "vinext start",
    "db:migrate:local": "wrangler d1 migrations apply autoyj-portal --local --persist-to .wrangler/local-d1",
    "db:migrate:remote": "node scripts/d1/apply-remote-migrations.mjs",
    "deploy": "bun run db:migrate:remote && BUILD_TARGET=cloudflare vinext-cloudflare deploy",
    "deploy:with-pull": "bun run tolgee:pull:server && bun run deploy",
    "check": "oxlint && vinext check",
    "check:i18n": "bun run scripts/check-i18n.ts",
    "lint:fast": "oxlint",
    "lint": "oxlint && vinext lint",
    "audit": "bun audit --registry=https://registry.npmjs.org/",
    "audit:lighthouse": "bun run scripts/audit-lighthouse.ts",
    "audit:w3c": "bun run scripts/audit-w3c-standards.ts",
    "pre-push": "bun run gate:push",
    "test": "bun test tests/unit tests/component tests/integration",
    "test:unit": "bun test tests/unit",
    "test:component": "bun test tests/component",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bunx playwright test",
    "tdd": "bun test --watch tests/unit tests/component",
    "tdd:domain": "bun test --watch tests/unit/domain",
    "tdd:integration": "bun test --watch tests/integration",
    "test:coverage": "bun test --coverage tests/unit tests/component tests/integration",
    "test:cov:check": "bun run test:coverage && bun run scripts/tdd/check-coverage.ts",
    "test:all": "bun run test && bun run test:e2e",
    "db:local:init": "wrangler d1 execute autoyj-portal --local --persist-to .wrangler/local-d1 --file=server/db/schema.sql --yes && wrangler d1 migrations apply autoyj-portal --local --persist-to .wrangler/local-d1",
    "db:local:sync": "node scripts/d1/sync-local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply autoyj-portal --local",
    "db:export:remote": "bun run scripts/d1/d1-admin.ts export remote",
    "db:export:local": "bun run scripts/d1/d1-admin.ts export local",
    "db:pull:remote": "bun run scripts/d1/d1-admin.ts pull-remote",
    "db:import:local": "bun run scripts/d1/d1-admin.ts import local",
    "setup:feishu": "node scripts/feishu/setup-feishu-base.mjs",
    "sync:feishu-data": "node scripts/feishu/import-frontend-to-feishu.mjs",
    "sync:feishu-env": "node scripts/feishu/sync-feishu-env.mjs",
    "tg:info": "bun run scripts/telegram-cli.ts info",
    "tg:cli": "bun run scripts/telegram-cli.ts",
    "tg:test": "bun run scripts/test-telegram-live-alerts.ts",
    "shadcn": "shadcn",
    "tolgee:push": "bun run scripts/tolgee/sync.ts push",
    "tolgee:pull": "bun run scripts/tolgee/sync.ts pull",
    "tolgee:pull:server": "bun --env-file=.env.build run scripts/tolgee/pull-translations.ts",
    "deploy:preview": "bun --env-file=.env.preview run scripts/tolgee/deploy-preview.ts",
    "tolgee:setup": "bun run scripts/tolgee/setup-tolgee-jar.ts",
    "tolgee:server": "bun run scripts/tolgee/setup-tolgee-jar.ts --run",
    "heal:e2e": "bun run scripts/agent-e2e-heal.ts",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "prepare": "husky || true",
    "gate:fast": "bun run scripts/ci/gate-fast.ts",
    "gate:push": "bun run scripts/ci/gate-push.ts",
    "gate:full": "bun run scripts/ci/gate-full.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.5",
    "@block65/webcrypto-web-push": "^1.0.2",
    "@sentry/nextjs": "^10.70.0",
    "@tolgee/core": "^7.1.3",
    "@tolgee/format-icu": "^7.1.3",
    "@tolgee/react": "^7.1.3",
    "@tolgee/web": "^7.1.3",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.0.0-beta.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.5",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^4.20260507.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.32",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "html-validate": "^11.8.0",
    "knip": "^6.31.0",
    "msw": "^2.15.0",
    "oxlint": "^1.78.0",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "nanoid": "^3.3.18",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.0"
  }
}
