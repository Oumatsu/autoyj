{
  "name": "youguard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:local:init && vinext dev",
    "build": "vinext build",
    "build:cloudflare": "BUILD_TARGET=cloudflare vinext build",
    "build:standalone": "BUILD_TARGET=standalone vinext build",
    "build:server": "vinext build",
    "start": "vinext start",
    "deploy": "BUILD_TARGET=cloudflare vinext-cloudflare deploy",
    "deploy:with-pull": "bun run tolgee:pull:server && bun run deploy",
    "check": "vinext check",
    "check:i18n": "bun run scripts/check-i18n.ts",
    "lint": "vinext lint",
    "test": "bun test tests/unit tests/component tests/integration",
    "test:unit": "bun test tests/unit",
    "test:component": "bun test tests/component",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bunx playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "db:local:init": "wrangler d1 execute autoyj-portal --local --persist-to .wrangler/state --file=server/db/schema.sql --yes",
    "db:local:sync": "node scripts/d1/sync-local.mjs",
    "setup:feishu": "node scripts/feishu/setup-feishu-base.mjs",
    "sync:feishu-data": "node scripts/feishu/import-frontend-to-feishu.mjs",
    "sync:feishu-env": "node scripts/feishu/sync-feishu-env.mjs",
    "tolgee:push": "bun run scripts/tolgee/sync.ts push",
    "tolgee:pull": "bun run scripts/tolgee/sync.ts pull",
    "tolgee:pull:server": "bun --env-file=.env.build run scripts/tolgee/pull-translations.ts",
    "deploy:preview": "bun --env-file=.env.preview run scripts/tolgee/deploy-preview.ts",
    "tolgee:setup": "bun run scripts/tolgee/setup-tolgee-jar.ts",
    "tolgee:server": "bun run scripts/tolgee/setup-tolgee-jar.ts --run",
    "knip": "knip"
  },
  "dependencies": {
    "@tolgee/core": "^7.1.3",
    "@tolgee/format-icu": "^7.1.3",
    "@tolgee/react": "^7.1.3",
    "@tolgee/web": "^7.1.3",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^4.20260507.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vinext/cloudflare": "^1.0.0-beta.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.32",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "knip": "^6.31.0",
    "msw": "^2.15.0",
    "react-server-dom-webpack": "^19.2.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
