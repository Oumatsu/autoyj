{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "app/**/*.css",
    "components/**/*.{ts,tsx}",
    "i18n/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "server/**/*.{ts,tsx}",
    "views/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@testing-library/jest-dom",
    "eslint-config-next"
  ],
  "ignoreBinaries": ["java"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "components/ui/**": ["exports", "types"],
    "lib/auth.ts": ["exports", "types"],
    "lib/users.ts": ["exports", "types"],
    "i18n/translations/index.ts": ["types"],
    "i18n/useTranslation.ts": ["exports", "types"],
    "server/db/d1.ts": ["exports", "types"],
    "views/products/catalogFilters.ts": ["types"],
    "server/api/productFilters.ts": ["types"]
  }
}
