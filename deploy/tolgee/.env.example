# Tolgee server environment variables
# Copy to .env and fill in before running docker compose up

# PostgreSQL password for tolgee-db container
POSTGRES_PASSWORD=TolgeeDB_Change_Me_2024

# Tolgee admin credentials (first-run setup)
TOLGEE_ADMIN_USER=admin
TOLGEE_ADMIN_PASSWORD=TolgeeAdmin_Change_Me_2024

# Public URL of this Tolgee instance (used in emails / OAuth redirects)
TOLGEE_FRONTEND_URL=http://152.32.175.18:8080
