{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-hooks",
    "jsx-a11y",
    "nextjs",
    "typescript"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "nextjs/no-html-link-for-pages": "off",
    "nextjs/no-img-element": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    ".vinext/**",
    "dist/**",
    "node_modules/**",
    ".agents/**",
    "coverage/**",
    "test-results/**",
    "public/**",
    "scripts/**"
  ]
}
